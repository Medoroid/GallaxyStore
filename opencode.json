{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/deepseek-coder-v2-opencode",

  "small_model": "ollama/deepseek-coder-v2-opencode",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",

      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },

      "models": {
        "deepseek-coder-v2-opencode": {
          "name": "DeepSeek Coder V2 OpenCode",

          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },

  "shell": "pwsh",

  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "bash": true
  },

  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=httywgkwfqvrbuwuzutu&read_only=true"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    }
  }
}